{
  "schemaVersion": 2,
  "piVersion": "1.3.0",
  "skillInstaller": "skills@1.7.0",
  "managedSettings": {
    "theme": "dark",
    "defaultThinkingLevel": "high",
    "tuiMode": "fullscreen",
    "quietStartup": "header",
    "compaction": {
      "enabled": true,
      "reserveTokens": 16384,
      "keepRecentTokens": 20000
    },
    "enableSkillCommands": true
  },
  "defaultSettings": {
    "defaultTools": [
      "+codemode"
    ]
  },
  "solPi": {
    "source": "git:github.com/CheeseFox259/SoL-Pi@93fd67a833da1b6236cf2582f02f7a6454d6d941",
    "pinnedRef": "93fd67a833da1b6236cf2582f02f7a6454d6d941",
    "reducerPolicy": {
      "maxRequestsPerSession": 20
    }
  },
  "packages": [
    {
      "source": "git:github.com/CheeseFox259/SoL-Pi@93fd67a833da1b6236cf2582f02f7a6454d6d941",
      "extensions": [],
      "capabilities": [
        "observation-pack",
        "action-fusion",
        "log-reducer",
        "online-compaction"
      ]
    },
    {
      "source": "npm:pi-web-access@0.37.0",
      "capabilities": [
        "research",
        "fetch"
      ]
    },
    {
      "source": "npm:pi-matt-subagent@0.9.0",
      "capabilities": [
        "parallel-agents",
        "background-research",
        "review"
      ]
    },
    {
      "source": "npm:pi-agent-browser-native@0.9.3",
      "capabilities": [
        "browser-verification"
      ]
    },
    {
      "source": "npm:@narumitw/pi-lsp@0.49.9",
      "capabilities": [
        "diagnostics",
        "source-fixes"
      ]
    },
    {
      "source": "npm:@aliou/pi-processes@0.13.2",
      "capabilities": [
        "dev-server",
        "logs"
      ]
    },
    {
      "source": "npm:@aliou/pi-guardrails@0.19.0",
      "capabilities": [
        "deterministic-guardrails"
      ]
    },
    {
      "source": "npm:@narumitw/pi-statusline@0.50.2",
      "capabilities": [
        "statusline",
        "context-usage",
        "token-cost-display"
      ]
    }
  ],
  "mcpDefaults": {
    "ask-user-questions": {
      "enabled": false
    },
    "MiniMax": {
      "enabled": false
    }
  },
  "mcpServers": {
    "codebase-memory": {
      "package": "codebase-memory-mcp@0.11.0",
      "dataEnv": "CBM_CACHE_DIR",
      "description": "Local code graph: index repositories, search symbols, trace calls, inspect architecture and index coverage. Verify graph findings against source; no ADR writes or project deletion.",
      "tools": [
        "index_repository",
        "search_graph",
        "query_graph",
        "trace_path",
        "get_code_snippet",
        "get_file_outline",
        "get_graph_schema",
        "compare_graphs",
        "get_architecture",
        "search_code",
        "list_projects",
        "index_status",
        "check_index_coverage",
        "detect_changes"
      ]
    },
    "context-mode": {
      "package": "context-mode@1.0.169",
      "dataEnv": "CONTEXT_MODE_DIR",
      "description": "Local document FTS5 indexing and BM25 retrieval via ctx_index/ctx_search. Stats describe this server only; no arbitrary execution, web fetch, lifecycle hooks or automatic Pi session memory.",
      "tools": [
        "ctx_index",
        "ctx_search",
        "ctx_stats"
      ]
    }
  },
