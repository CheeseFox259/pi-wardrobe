{
  "name": "@pi-wardrobe/manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Native Pi composer preset management, clean session switching, defaults and updates.",
  "license": "MIT",
  "bin": {
    "wardrobe": "bin/wardrobe.mjs"
  },
  "pi": {
    "extensions": [
      "extensions/index.mjs"
    ],
    "skills": ["skills/wardrobe-update", "skills/wardrobe-maintain"],
    "prompts": [],
    "themes": []
  },
  "wardrobe": {
    "kind": "manager",
    "commands": [
      "create",
      "edit",
      "copy",
      "draft",
      "drafts",
      "save",
      "import",
      "export",
      "bind",
      "current",
      "presets",
      "use",
      "default",
      "updates",
      "update",
      "maintain",
      "details",
      "resume",
      "verify",
      "repair",
      "uninstall",
      "list",
      "show",
      "explain",
      "install",
      "status",
      "doctor"
    ]
  }
}
